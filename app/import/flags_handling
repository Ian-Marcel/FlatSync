#!/usr/bin/env bash

for flag in "${FLAGS[@]}";do
	case "$flag" in
		-v|--version)
			printf "flatsync: ${FLATSYNC_VERSION}v\n"
			exit 0
			;;
		-q|--quiet)
			VERBOSE=0
			;;
		-a|--auto)
			AUTO_OP_FLATPAKS=1
			;;
		-aq|-qa)
			VERBOSE=0
			AUTO_OP_FLATPAKS=1
			;;
		--id=make)
			if [ -s "$FLATSYNC_GIT"/last_updated_device ] && [ -s /usr/share/flatsync/flatsync-id ]; then
				OLD_ID_LOCAL=$(printf "%s" "$(cat /usr/share/flatsync/flatsync-id)")
				LAST_ID=$( tail -n 1 "$FLATSYNC_GIT"/last_updated_device )
				if [ "$OLD_ID_LOCAL" = "$LAST_ID" ]; then
					UPDATE_LUD=1
				fi
			fi
			###
			printf "%s" "$(openssl rand -base64 32)" |
				sudo tee -p /usr/share/flatsync/flatsync-id 1>/dev/null
			sudo chown root:root	/usr/share/flatsync/flatsync-id
			sudo chmod 644			/usr/share/flatsync/flatsync-id
			###
			if [ "${UPDATE_LUD-}" ] && [ "$UPDATE_LUD" -eq 1 ]; then
				cd "$FLATSYNC_GIT" || exit
				read -r LUD_FLATSYNC_ID < /usr/share/flatsync/flatsync-id
				printf "%s\n%s" "$(cat /etc/hostname)" "$LUD_FLATSYNC_ID" 1>last_updated_device
				git add .
				if git commit -q -m "$(date "%H:%M:%S - %d/%m/%Y")" &>/dev/null; then
					git push -q
				else
					exit 0
				fi
			fi
			###
			exit 0
			;;
		--id=get)
			if [ -s /usr/share/flatsync/flatsync-id ]; then
				printf "${BGREEN}The current ID of this device is:${NC}\n%s\n" \
					"$(cat /usr/share/flatsync/flatsync-id)"
			else
				printf "${BRED}No ID found!!! Run ${BCYAN}flatsync --id=make${BRED} to create it ${NC}\n"
			fi
			exit 0
			;;
	esac
done

silencer_check() {
	if [ "$VERBOSE" -eq 0 ]; then
		"$@" >/dev/null
	else
		"$@"
	fi
}
