#!/usr/bin/env bash

LOCKFILE=/run/user/"$UID"/flatsync.lock
AUTOSTART_FILE="$HOME/.config/autostart/FlatSync.desktop"
INT_REGEX='^[0-9]+$'

# function check-dir_cache
check-dir_cache

# Main flag handling
while (($# > 0)); do
    case "$1" in
    -D | --debug)
        shift
        continue
        ;;
    -v | --version)
        printf "flatsync: ${FLATSYNC_VERSION}v\n"
        exit 0
        ;;
    -a | --automatic)
        AUTO_OP_FLATPAKS=true
        VERBOSE=false
        touch "$FLATSYNC_CACHE/running_automaticaly"
        sleep 1s
        rm "$FLATSYNC_CACHE/running_automaticaly"
        ;;
    -s | --schedule)
        shift
        int=${1:-10}
        if [[ ! "$int" =~ $INT_REGEX ]]; then
            printf "Error: \"%s\" is an invalid value! \n" "$int"
            printf "Flag '-s' | '--schedule' doesn't support chars or floats.\n"

            printf "SCHEDULE FLAG FAILED DUE TO INVALID VALUE!" &>/dev/null # 1
            exit 1
        else
            SCHEDULE_DURATION=$((int * 60))
        fi
        if [ -e "$LOCKFILE" ]; then
            CURRENT_SCHEDULE=$(cat "$FLATSYNC_CACHE"/shedule_duration)
            CURRENT_DURATION=$((CURRENT_SCHEDULE / 60))
            printf "Scheduler is already enabled (lockfile exists: %s)! \n" "$LOCKFILE"
            printf "  '---> Currently FlatSync runs each: %s minutes\n" "$CURRENT_DURATION"
            printf "Run 'flatsync -S' to stop the current schedule. \n"
            exit 1
        else
            printf "%s" "$SCHEDULE_DURATION" >"$FLATSYNC_CACHE"/shedule_duration
        fi
        touch "$LOCKFILE"
        schedule_function() {
            while [ -e "$LOCKFILE" ]; do
                flatsync --automatic
                sleep ${SCHEDULE_DURATION}s
            done
        }
        # flock -n "$LOCKFILE" -c schedule_function >/dev/null 2>&1 &
        schedule_function &
        printf "%s" "$!" >"${LOCKFILE%%.*}.pid"
        CURRENT_DURATION=$((SCHEDULE_DURATION / 60))
        printf "FlatSync will run each %s minutes from now on. \n" "$CURRENT_DURATION"
        exit 0
        ;;
    -S | --stop-schedule)
        if [ -e "$LOCKFILE" ]; then
            kill "$(cat /run/user/$UID/flatsync.pid)" &&
                rm /run/user/$UID/flatsync.pid
            rm -f "$LOCKFILE"
            printf "Flatsync deactivated — will not run automatically for this session. \n"
        else
            printf "Flatsync isn't running anyway — nothing to deactivate. \n"
        fi
        exit 0
        ;;
    -k | --kill-schedule)
        if [ -e "$LOCKFILE" ] && [ -e "$AUTOSTART_FILE" ]; then
            kill "$(cat /run/user/$UID/flatsync.pid)" &&
                rm /run/user/$UID/flatsync.pid
            rm -f "$LOCKFILE"
            rm -f "$AUTOSTART_FILE"
            printf "Flatsync killed — will not run automatically anymore. \n"
        elif [ -e "$AUTOSTART_FILE" ]; then
            rm -f "$LOCKFILE"
            rm -f "$AUTOSTART_FILE"
            printf "Flatsync killed — will not run automatically anymore. \n"
        else
            printf "Flatsync isn't setup to run — nothing to kill. \n"
        fi
        exit 0
        ;;
    --perma-schedule)
        shift
        int=${1:-10}
        if [[ ! "$int" =~ $INT_REGEX ]]; then
            printf "Error: \"%s\" is an invalid value! \n" "$int"
            printf "Flag '-s'|'--schedule' doesn't support chars or floats.\n"

            printf "SCHEDULE FLAG FAILED DUE TO INVALID VALUE!" &>/dev/null # 1
            exit 1
        else
            SCHEDULE_DURATION=$int
        fi

        if [[ -e "$AUTOSTART_FILE" ]]; then
            CURRENT_SCHEDULE=$(cat "$FLATSYNC_CACHE"/shedule_duration)
            CURRENT_DURATION=$((CURRENT_SCHEDULE / 60))
            printf "Permanent scheduler is already enabled (autostart file exists: %s)! \n" "$AUTOSTART_FILE"
            printf "   '---> Currently FlatSync runs each: %s minutes\n" "$CURRENT_DURATION"
            printf "Run 'flatsync -k' to stop the current schedule. \n"
            exit 1
        fi
        cat >"$AUTOSTART_FILE" <<EOF
[Desktop Entry]
Type=Application
Name=Flatsync
Exec=/usr/local/bin/flatsync --schedule $SCHEDULE_DURATION
X-GNOME-Autostart-enabled=true
Hidden=false
Comment=Runs FlatSync periodically.
Terminal=false
EOF
        printf "FlatSync will run each %s minutes on next login. \n" "$SCHEDULE_DURATION"
        exit 0
        ;;
    --id)
        shift
        if [ ! "${1-}" ]; then
            option="get"
        else
            option=$1
        fi
        if [ "$option" = "create" ]; then
            if [ "$(whoami)" != root ]; then
                if ! sudo -v; then
                    echo -e "${BRED}Failed to elevate privileges! \n${BYELLOW}Exiting...${NC}\n"
                    exit 1
                fi
            fi
            if [ -s "$FLATSYNC_GIT"/last_updated_device ] && [ -s /usr/share/flatsync/flatsync-id ]; then
                OLD_ID_LOCAL=$(printf "%s" "$(cat /usr/share/flatsync/flatsync-id)")
                LAST_ID=$(tail -n 1 "$FLATSYNC_GIT"/last_updated_device)
                if [ "$OLD_ID_LOCAL" = "$LAST_ID" ]; then
                    UPDATE_LUD=true
                fi
            fi
            ###
            printf "%s" "$(openssl rand -base64 32)" |
                sudo tee -p /usr/share/flatsync/flatsync-id 1>/dev/null
            sudo chown root:root /usr/share/flatsync/flatsync-id
            sudo chmod 644 /usr/share/flatsync/flatsync-id
            ###
            if [ "${UPDATE_LUD-}" ] && [ "$UPDATE_LUD" = true ]; then
                cd "$FLATSYNC_GIT" || exit
                LUD_FLATSYNC_ID=$(printf "%s" "$(cat /usr/share/flatsync/flatsync-id)")
                printf "%s\n%s" "$(cat /etc/hostname)" "$LUD_FLATSYNC_ID" 1>last_updated_device
                git add .
                if git commit -q -m "$(date "%H:%M:%S - %d/%m/%Y")" &>/dev/null; then
                    git push -q
                else
                    exit 0
                fi
            fi
            ###
            exit 0
        elif [ "$option" = "get" ]; then
            if [ -s /usr/share/flatsync/flatsync-id ]; then
                printf "${BGREEN}The current ID of this device is:${NC}\n%s\n" \
                    "$(cat /usr/share/flatsync/flatsync-id)"
            else
                printf "${BRED}No ID found!!! Run ${BCYAN}flatsync --id=make${BRED} to create it ${NC}\n"
            fi
            exit 0
        elif [ "$option" != "get" ] && [ "$option" != "create" ]; then
            echo "Error! Flag '--id' requires an option ('create' or 'get')!"
            exit 1
        fi
        ;;
    -?* | *)
        printf "Error: Unknown flag '%s'\n" "$1"
        exit 1
        ;;
    esac
    shift
done

silencer_check() {
    if [ "$VERBOSE" = false ]; then
        "$@" >/dev/null
    else
        "$@"
    fi
}
