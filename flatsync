#!/usr/bin/env bash

############
set -euo pipefail
trap 'printf "❌ \033[1;31m\b Error occurred! \033[1;33m\b Exiting...\033[0m\n" && exit 1' ERR
FLATSYNC_ROOT="/usr/share/flatsync"			# comment.?
FLATSYNC_DATA="$HOME/.local/share/flatsync" # comment.5
import() {
	local FLATSYNC_IMPORTS="$FLATSYNC_ROOT/import"
	local library=$1
	source "$FLATSYNC_IMPORTS"/"$library"
}
############

import global_variables
import flags_handling
import pure_bash_functions
import progress_bar_by_task_completion
import wait_with_spinner_loading

silencer_check printf "Updating repository\n"
exit 1
source "$FLATSYNC_SCRIPT"/git.sh

source "$FLATSYNC_SCRIPT"/compare.sh

if [ -e "$FLATSYNC_CACHE"/uninstall ]; then
	printf "${BRED}Removing...${NC}\n"
	source "$FLATSYNC_SCRIPT"/uninstall_apps.sh
else
	silencer_check printf "${BYELLOW}Nothing to remove${NC}\n"
	NO_TODO=$((NO_TODO+1))
fi

if [ -e "$FLATSYNC_CACHE"/install ]; then
	printf "${BGREEN}Installing...${NC}\n"
	source "$FLATSYNC_SCRIPT"/install_apps.sh
else
	silencer_check printf "${BYELLOW}Nothing to install${NC}\n"
	NO_TODO=$((NO_TODO+1))
fi

source "$FLATSYNC_SCRIPT"/exit.sh

