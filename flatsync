#!/usr/bin/env bash

### Exit on error and failure on unset variables ###
set -euo pipefail
trap 'printf "❌ \033[1;31m\b Error occurred! \033[1;33m\b Exiting...\033[0m\n" && exit 1' ERR
### Setting important stuff ###
FLATSYNC_ROOT="$PWD" # comment.?
FLATSYNC_DATA="$PWD/flatsyncd" # comment.5
import() {
	local library=$1
	source "$FLATSYNC_DATA"/app/import/"$library"
}
source "$FLATSYNC_DATA"/app/source/check-if-FLATSYNC_DATA-dirs-exists.sh
######

import pure_bash_functions
import global_variables
import progress_bar_by_task_completion
import wait_with_spinner_loading

printf "Check Git repo\n"
source "$FLATSYNC_SCRIPT"/git.sh

printf "Comparing\n"
source "$FLATSYNC_SCRIPT"/compare.sh

if [ -e "$FLATSYNC_CACHE"/uninstall ]; then
	echo -e "${BRED}Removing...${NC}"
	source "$FLATSYNC_SCRIPT"/uninstall_apps.sh
else
	echo -e "${BYELLOW}Nothing to remove${NC}"
fi

if [ -e "$FLATSYNC_CACHE"/install ]; then
	echo -e "${BGREEN}Installing...${NC}"
	source "$FLATSYNC_SCRIPT"/install_apps.sh
else
	echo -e "${BYELLOW}Nothing to install${NC}"
fi

mv "$FLATSYNC_CACHE"/remote_flatpaks \
	"$FLATSYNC_DATA"/history/synced_flatpaks-"$DATE".old
shred -u "$FLATSYNC_CACHE"/*

cd "$FLATSYNC_GIT" || exit
flatpak list --columns=application --app |
	tee -p remote_flatpaks &>/dev/null
git add .
git commit -q -m "$(date "%H:%M:%S - %d/%m/%Y")" &>/dev/null
git push -q &>/dev/null
echo "$PWD"

