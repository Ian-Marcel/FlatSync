#!/usr/bin/env bash

### Exit on error and failure on unset variables ###
set -euo pipefail
trap 'printf "❌ \033[1;31m\b Error occurred! \033[1;33m\b Exiting...\033[0m\n" && exit 1' ERR
### Setting working directory ###
FLATSYNC_DATA="$PWD/flatsyncd" # comment.5
#mkdir -p "$FLATSYNC_DATA"/{git,history,app/{source,cache}} # decomentar se FLATSYNC_DATA não existir
######

source "$FLATSYNC_DATA"/app/source/global_variables
source "$FLATSYNC_DATA"/app/source/pure_bash_functions

flatpak list --columns=application --app |
	tee -p "$FLATSYNC_DATA"/app/cache/local_flatpaks &>/dev/null
cp "$FLATSYNC_DATA"/git/remote_flatpaks "$FLATSYNC_DATA"/app/cache/

diff "$FLATSYNC_DATA"/app/cache/remote_flatpaks "$FLATSYNC_DATA"/app/cache/local_flatpaks |
	grep ">" |
	awk -F ">" '{ print $2 }' |
	tr -d "\n" |
	tee -p "$FLATSYNC_DATA"/app/cache/uninstall &>/dev/null # comment.2
diff "$FLATSYNC_DATA"/app/cache/remote_flatpaks "$FLATSYNC_DATA"/app/cache/local_flatpaks |
	grep "<" |
	awk -F "<" '{ print $2 }' |
	tr -d "\n" |
	tee -p "$FLATSYNC_DATA"/app/cache/install &>/dev/null # comment.1

echo -e "${BRED}Removing...${NC}"
flatpak uninstall "$(<"$FLATSYNC_DATA"/app/cache/uninstall)"
echo -e "${BGREEN}Installing...${NC}"
flatpak install "$(<"$FLATSYNC_DATA"/app/cache/install)"

mv -v "$FLATSYNC_DATA"/app/cache/remote_flatpaks \
	"$FLATSYNC_DATA"/history/synced_flatpaks-"$DATE".old
shred -u "$FLATSYNC_DATA"/app/cache/local_flatpaks
flatpak list --columns=application --app |
	tee -p "$FLATSYNC_DATA"/git/remote_flatpaks &>/dev/null

